# Copie para .env e preencha. O servidor lê .env automaticamente.
PORT=3000
NODE_ENV=production
# Endereço público do site (usado nos links dos e-mails). Ex.: https://gabarito.seudominio.com.br
BASE_URL=http://localhost:3000
# Onde fica o banco SQLite. Em hospedagem, use um disco persistente.
DB_PATH=./data/gabarito.db
# Quem se cadastrar com este e-mail vira administrador.
ADMIN_EMAIL=
# 1 = só entra quem confirmou o e-mail
REQUIRE_VERIFIED=0
# E-mail de verdade: crie conta em resend.com, verifique seu domínio e cole a chave.
RESEND_API_KEY=
MAIL_FROM=Gabarito <nao-responda@seudominio.com.br>
# Link do app de estudo (botão "Abrir o Gabarito" no painel)
APP_URL=https://claude.ai/artifact/2EjaBrk31grVF666VEVihV
